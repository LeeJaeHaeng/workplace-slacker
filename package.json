{
  "name": "vscodetube",
  "displayName": "VScodetube",
  "description": "Explorer 사이드바에서 YouTube를 검색하고 보면서 코딩",
  "publisher": "leejaehaeng",
  "version": "0.0.1",
  "engines": {
    "vscode": "^1.140.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [],
  "main": "./dist/extension.js",
  "contributes": {
    "views": {
      "explorer": [
        {
          "type": "webview",
          "id": "vscodetube.player",
          "name": "YouTube"
        }
      ]
    },
    "commands": [
      {
        "command": "vscodetube.back",
        "title": "VScodetube: 뒤로",
        "icon": "$(arrow-left)"
      },
      {
        "command": "vscodetube.home",
        "title": "VScodetube: YouTube 홈",
        "icon": "$(home)"
      },
      {
        "command": "vscodetube.open",
        "title": "VScodetube: 검색 또는 URL 열기",
        "icon": "$(search)"
      },
      {
        "command": "vscodetube.clear",
        "title": "VScodetube: 닫기",
        "icon": "$(close)"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "vscodetube.back",
          "when": "view == vscodetube.player",
          "group": "navigation@1"
        },
        {
          "command": "vscodetube.home",
          "when": "view == vscodetube.player",
          "group": "navigation@2"
        },
        {
          "command": "vscodetube.open",
          "when": "view == vscodetube.player",
          "group": "navigation@3"
        },
        {
          "command": "vscodetube.clear",
          "when": "view == vscodetube.player",
          "group": "navigation@4"
        }
      ]
    },
    "configuration": {
      "title": "VScodetube",
      "properties": {
        "vscodetube.autoplay": {
          "type": "boolean",
          "default": true,
          "description": "검색 또는 URL 열기로 영상을 열 때 자동 재생"
        },
        "vscodetube.restoreLastVideo": {
          "type": "boolean",
          "default": true,
          "description": "VS Code를 다시 열었을 때 마지막으로 보던 페이지 복원 (영상은 일시정지 상태)"
        },
        "vscodetube.browserPath": {
          "type": "string",
          "default": "",
          "description": "재생에 사용할 Chromium 계열 브라우저(Chrome/Edge) 실행 파일 경로. 비우면 Chrome → Edge 순으로 자동 탐색"
        },
        "vscodetube.pageWidth": {
          "type": "number",
          "default": 1280,
          "minimum": 320,
          "maximum": 2560,
          "description": "YouTube를 렌더링할 PC 화면 폭(px). 사이드바 크기에 맞춰 비율 그대로 축소해 보여줍니다."
        },
        "vscodetube.autoFullscreen": {
          "type": "boolean",
          "default": true,
          "description": "영상을 열면 플레이어를 섹션 크기에 꽉 채움 (Esc 또는 더블클릭으로 해제)"
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run package",
    "compile": "npm run check-types && npm run lint && node esbuild.js",
    "watch": "npm-run-all -p watch:*",
    "watch:esbuild": "node esbuild.js --watch",
    "watch:tsc": "tsc --noEmit --watch --project tsconfig.json",
    "package": "npm run check-types && npm run lint && node esbuild.js --production",
    "compile-tests": "tsc -p . --outDir out",
    "watch-tests": "tsc -p . -w --outDir out",
    "pretest": "npm run compile-tests && npm run compile && npm run lint",
    "check-types": "tsc --noEmit",
    "lint": "eslint src",
    "test": "vscode-test"
  },
  "devDependencies": {
    "@types/vscode": "^1.140.0",
    "@types/mocha": "^10.0.10",
    "@types/node": "24.x",
    "typescript-eslint": "^8.61.1",
    "eslint": "^10.5.0",
    "esbuild": "^0.28.1",
    "npm-run-all": "^4.1.5",
    "typescript": "^6.0.3",
    "@vscode/test-cli": "^0.0.15",
    "@vscode/test-electron": "^3.0.0"
  },
  "overrides": {
    "diff": "^8.0.4",
    "serialize-javascript": "^7.0.6"
  }
}
